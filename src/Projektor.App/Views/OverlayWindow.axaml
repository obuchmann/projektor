<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Projektor.App.ViewModels"
        xmlns:models="using:Projektor.Core.Models"
        x:Class="Projektor.App.Views.OverlayWindow"
        x:DataType="vm:OverlayViewModel"
        Title="Projektor"
        Width="760"
        Height="480"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur, Blur, Mica"
        WindowStartupLocation="CenterScreen">

  <Panel Margin="14">
    <!-- Soft drop shadow layer -->
    <Border CornerRadius="20"
            Background="#16161F"
            IsHitTestVisible="False">
      <Border.Effect>
        <DropShadowEffect Color="#000000" BlurRadius="34" OffsetX="0" OffsetY="14" Opacity="0.5" />
      </Border.Effect>
    </Border>

    <!-- Frosted-glass backdrop -->
    <ExperimentalAcrylicBorder IsHitTestVisible="False"
                               CornerRadius="20">
      <ExperimentalAcrylicBorder.Material>
        <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                     TintColor="#1E1E2E"
                                     TintOpacity="1"
                                     MaterialOpacity="0.72" />
      </ExperimentalAcrylicBorder.Material>
    </ExperimentalAcrylicBorder>

    <!-- Content surface with hairline highlight edge -->
    <Border CornerRadius="20"
            BorderBrush="{StaticResource GlassEdgeBrush}"
            BorderThickness="1"
            Padding="22">

      <DockPanel>

        <!-- Header -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="2,0,2,16">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Width="10" Height="10" CornerRadius="5"
                    Background="{StaticResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Projektor"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Column="2"
                     VerticalAlignment="Center"
                     FontSize="11"
                     Foreground="{StaticResource MutedBrush}"
                     Text="Alt+Space" />
        </Grid>

        <!-- Search -->
        <TextBox x:Name="SearchBox"
                 Classes="search"
                 DockPanel.Dock="Top"
                 PlaceholderText="Projekt suchen…"
                 Margin="0,0,0,16"
                 Text="{Binding SearchText}" />

        <!-- Status -->
        <TextBlock DockPanel.Dock="Bottom"
                   Margin="2,12,2,0"
                   FontSize="12"
                   Foreground="{StaticResource DangerBrush}"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Text="{Binding StatusMessage}" />

        <!-- Hint bar -->
        <Border DockPanel.Dock="Bottom"
                Margin="0,14,0,0"
                Padding="2,0">
          <WrapPanel Orientation="Horizontal">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,0">
              <Border Classes="kbd"><TextBlock Text="Enter" /></Border>
              <TextBlock Classes="hint" Text="Tool 1" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,0">
              <Border Classes="kbd"><TextBlock Text="Shift+Enter" /></Border>
              <TextBlock Classes="hint" Text="alle" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,0">
              <Border Classes="kbd"><TextBlock Text="Alt+1…9" /></Border>
              <TextBlock Classes="hint" Text="Tool" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Classes="kbd"><TextBlock Text="Esc" /></Border>
              <TextBlock Classes="hint" Text="schließen" />
            </StackPanel>
          </WrapPanel>
        </Border>

        <!-- Body: projects | actions -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">

          <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Classes="section" Text="PROJEKTE" />
            <ListBox x:Name="ProjectList"
                     Classes="projects"
                     ItemsSource="{Binding Projects}"
                     SelectedItem="{Binding SelectedProject}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:Project">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="{Binding Path}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource SubtextBrush}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Classes="section" Text="ACTIONS" />
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Actions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ActionItem">
                    <Button Classes="action"
                            Command="{Binding $parent[ItemsControl].((vm:OverlayViewModel)DataContext).LaunchCommand}"
                            CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                          <TextBlock Text="{Binding Name}"
                                     FontSize="15"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource TextBrush}" />
                          <TextBlock Text="{Binding Command}"
                                     FontSize="11"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{StaticResource SubtextBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Classes="kbd"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0"
                                IsVisible="{Binding ShortcutLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                          <TextBlock Text="{Binding ShortcutLabel}" />
                        </Border>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>

        </Grid>

      </DockPanel>
    </Border>
  </Panel>

</Window>
