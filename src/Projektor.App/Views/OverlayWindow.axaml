<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Projektor.App.ViewModels"
        xmlns:models="using:Projektor.Core.Models"
        x:Class="Projektor.App.Views.OverlayWindow"
        x:DataType="vm:OverlayViewModel"
        Title="Projektor"
        Width="720"
        Height="440"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowDecorations="None"
        Background="#1E1E2E"
        WindowStartupLocation="CenterScreen">

  <Border BorderBrush="#45475A"
          BorderThickness="1"
          Padding="16">
    <DockPanel>

      <TextBox x:Name="SearchBox"
               DockPanel.Dock="Top"
               PlaceholderText="Projekt suchen…"
               FontSize="20"
               Margin="0,0,0,12"
               Text="{Binding SearchText}" />

      <TextBlock DockPanel.Dock="Bottom"
                 Margin="0,12,0,0"
                 Foreground="#F38BA8"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{Binding StatusMessage}" />

      <TextBlock DockPanel.Dock="Bottom"
                 Margin="0,8,0,0"
                 FontSize="11"
                 Foreground="#6C7086"
                 Text="Klick = starten · Alt+1…9 = Tool · Enter = Tool 1 · Shift+Enter = alle · Esc = schließen" />

      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

        <ListBox Grid.Column="0"
                 x:Name="ProjectList"
                 ItemsSource="{Binding Projects}"
                 SelectedItem="{Binding SelectedProject}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:Project">
              <StackPanel Margin="2">
                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Path}" FontSize="11" Foreground="#9399B2" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <ScrollViewer Grid.Column="1">
          <ItemsControl ItemsSource="{Binding Actions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ActionItem">
                <Button Margin="0,0,0,6"
                        Padding="10,8"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Command="{Binding $parent[ItemsControl].((vm:OverlayViewModel)DataContext).LaunchCommand}"
                        CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Command}" FontSize="11" Foreground="#9399B2" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#6C7086"
                               Text="{Binding ShortcutLabel}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      </Grid>

    </DockPanel>
  </Border>

</Window>
